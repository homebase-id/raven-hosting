@* One plan, as a card in a list of plans. Every card has the same parts in the same order (storage, name,
   description, what it gives, prices, then the choice), so on a desktop they line up across plans *@
<li class="@Classes">
    <p class="storage">@Plan.Storage</p>
    @* The name, unless it only repeats the storage figure above it: then for screen readers only *@
    <h2 class="@(Plan.Name == Plan.Storage ? "visually-hidden" : null)">@Plan.Name</h2>
    <p class="description">@Plan.Description</p>
    <PlanDetails Plan="Plan" ShowDescription="false" ShowStorage="false" ShowPrices="false" ShowExplain="false" />
    <ul class="prices">
        @if (Plan.Prices.Count == 0 && IsFree)
        {
            <li>Free</li>
        }
        @foreach (var price in Plan.Prices)
        {
            <li><PriceLabel Plan="Plan" Price="price" /></li>
        }
    </ul>
    <div class="choice">
        @if (IsCurrent)
        {
            <p class="badge">Your plan</p>
        }
        else
        {
            @if (Fit?.Note != null)
            {
                <p class="@(Fit.IsMore ? "fit more" : "fit")">@Fit.Note</p>
            }
            @if (Fit?.CanChoose != false)
            {
                @Action
            }
        }
    </div>
</li>

@code {
    [Parameter, EditorRequired] public Plan Plan { get; set; } = null!;
    [Parameter] public bool IsCurrent { get; set; }

    /// <summary>The plan to suggest: its card is outlined and labelled "Recommended"</summary>
    [Parameter] public bool IsRecommended { get; set; }

    /// <summary>The plan a new identity starts on: it says "Free" where the prices go</summary>
    [Parameter] public bool IsFree { get; set; }

    /// <summary>How it compares with what the owner has now; null for a visitor</summary>
    [Parameter] public PlanFit? Fit { get; set; }

    /// <summary>The button, when it is not the owner's plan and they can choose it; none leaves the place empty</summary>
    [Parameter] public RenderFragment? Action { get; set; }

    private string Classes => "card" + (IsCurrent ? " current" : "") + (IsRecommended ? " recommended" : "");
}
