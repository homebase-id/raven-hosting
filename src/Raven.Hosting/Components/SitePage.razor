@* Every page, in the Ember Glow brand: a light header with the ember mark and the name in Night, who is signed in,
   the page's title and (in the upgrade) the steps; then the page; then the Night footer with the cream mark *@
@inject UpgradeSession Session
@inject AdminStore Admins
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@(Title == SiteName ? SiteName : $"{Title} - {SiteName}")</title>
@if (Description != null)
{
    <meta name="description" content="@Description">
}
@* The brand's icons (head-snippet.html), with the light theme's colour *@
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#FAF7F3">
<link rel="stylesheet" href="@SiteAssets.Stylesheet">
<script src="/assets/signup.js" defer></script>
<script src="/assets/menu.js" defer></script>
<script src="/assets/plan-now.js" defer></script>
</head>
<body>
<header class="@(Lead != null ? "site-header lead" : "site-header")">
    @* The bar is as wide as the widest page on every page, so the account is always at the right edge *@
    <div class="frame wide topbar">
        <a class="wordmark" href="/"><img src="/assets/brand/mark-ember.svg" alt="" width="48" height="48">@SiteName</a>
        <nav class="site-nav" aria-label="Main">
            <a href="/#plans">Plans</a>
            @if (_signedIn != null)
            {
                <a href="@AccountPages.Root" aria-current="@(IsHere(AccountPages.Root) ? "page" : null)">Your plan</a>
            }
        </nav>
        <div class="account">
            @if (_signedIn != null)
            {
                @* The avatar opens what is about the person: who they are, their Homebase, admin, sign out *@
                <details class="account-menu">
                    <summary aria-label="Account menu for @(_signedIn.Name ?? _signedIn.Identity)">
                        <span class="avatar-frame" aria-hidden="true">
                            @Initial
                            <img class="avatar" src="@PublicProfiles.ImageUrl(_signedIn.Identity)" alt="" width="36" height="36"
                                 referrerpolicy="no-referrer" onerror="this.remove()">
                        </span>
                        <span class="summary-name">@(_signedIn.Name ?? _signedIn.Identity)</span>
                    </summary>
                    <div class="menu-panel">
                        <p class="who-am-i">
                            @if (_signedIn.Name != null)
                            {
                                <span class="name">@_signedIn.Name</span>
                            }
                            <span class="identity">@_signedIn.Identity</span>
                        </p>
                        <a href="@AccountPages.Root">Your plan</a>
                        <a href="@($"https://{_signedIn.Identity}/owner")">Your Homebase</a>
                        @if (_isAdmin)
                        {
                            <a href="@AdminPages.Root">Admin</a>
                        }
                        <form method="post" action="@($"{UpgradePage.Root}/sign-out")">
                            <AntiforgeryField Token="_antiforgery!" />
                            <button type="submit">Sign out</button>
                        </form>
                    </div>
                </details>
            }
            else if (ShowSignIn)
            {
                <a class="button secondary" href="@SitePages.SignIn">Sign in</a>
            }
        </div>
    </div>
    <div class="@FrameClass">
        <h1>@Title</h1>
        @Lead
        @if (Step != null)
        {
            <Steps Current="Step.Value" />
        }
    </div>
</header>
<main class="@FrameClass">
    @ChildContent
</main>
<footer class="site-footer">
    <div class="@FrameClass">
        <a class="wordmark" href="/"><img src="/assets/brand/mark-cream.svg" alt="" width="28" height="28">@SiteName</a>
        <a href="/terms-and-conditions">Terms &amp; Conditions</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/report">Report abuse</a>
        <a href="https://homebase.id">Homebase</a>
    </div>
</footer>
</body>
</html>

@code {
    public const string SiteName = "Raven Hosting";

    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Description { get; set; }

    /// <summary>Under the title, in the header: the landing page's introduction</summary>
    [Parameter] public RenderFragment? Lead { get; set; }

    /// <summary>Which of the four upgrade steps this page is, from 0; null for a page outside them</summary>
    [Parameter] public int? Step { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Room for plans side by side on a desktop</summary>
    [Parameter] public bool Wide { get; set; }

    /// <summary>Whether the header offers "Sign in" to someone who is not; not on the sign-in page itself</summary>
    [Parameter] public bool ShowSignIn { get; set; } = true;

    private UpgradeSession.Data? _signedIn;
    private bool _isAdmin;
    private Microsoft.AspNetCore.Antiforgery.AntiforgeryTokenSet? _antiforgery;

    private string FrameClass => Wide ? "frame wide" : "frame";

    // The first letter of the name, or of the identity
    private string Initial => (_signedIn?.Name ?? _signedIn?.Identity ?? "?")[..1].ToUpperInvariant();

    private bool IsHere(string path) => HttpContext?.Request.Path.StartsWithSegments(path) == true;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext == null)
        {
            return;
        }

        // A sign-out answers with a redirect, so a page never shows a session it has just ended
        _signedIn = Session.Read(HttpContext);
        if (_signedIn != null)
        {
            _antiforgery = Antiforgery.GetAndStoreTokens(HttpContext);
            _isAdmin = await Admins.IsAdminAsync(_signedIn.Identity);
        }
    }
}
