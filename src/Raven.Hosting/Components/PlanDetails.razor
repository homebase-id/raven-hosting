@* The description, what the plan gives, and what each term costs. Every feature is listed, ticked when the plan has
   it and dashed when it does not, so what a bigger plan adds stands out; what a feature is, under it *@
@if (ShowDescription && Plan.Description != "")
{
    <p>@Plan.Description</p>
}
<ul class="gives">
    @if (ShowStorage)
    {
        <li class="has">@Plan.Storage of storage</li>
    }
    <Feature ShowExplain="ShowExplain" Has="Plan.PublicWebPresence" Name="A public home page"
             Explain="A page at your domain that anyone can visit, without signing in" />
    <Feature ShowExplain="ShowExplain" Has="Plan.PublicEmail" Name="A public email address"
             Explain="An address at your own domain that anyone can write to" />
    <Feature ShowExplain="ShowExplain" Has="Plan.EmailAliases > 0" Name="@Aliases"
             Explain="More addresses at your domain, all arriving in the same inbox" />
</ul>
@if (ShowPrices && Plan.Prices.Count > 0)
{
    <ul class="prices">
        @foreach (var price in Plan.Prices)
        {
            <li><PriceLabel Plan="Plan" Price="price" /></li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Plan Plan { get; set; } = null!;
    [Parameter] public bool ShowDescription { get; set; } = true;

    /// <summary>Whether each feature says what it is, under it</summary>
    [Parameter] public bool ShowExplain { get; set; } = true;
    [Parameter] public bool ShowStorage { get; set; } = true;
    [Parameter] public bool ShowPrices { get; set; } = true;

    private string Aliases => Plan.EmailAliases switch
    {
        0 => "Email aliases",
        1 => "1 email alias",
        var n => $"{n} email aliases",
    };
}
