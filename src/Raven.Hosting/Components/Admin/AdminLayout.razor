@* Every admin page: the admin bar (who is signed in, the site, sign out), the sections, the page's title and what
   the last change did, then the page. Its own document and stylesheet (Tailwind, admin.css), apart from the site's *@
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>@Title - Raven Hosting admin</title>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="@SiteAssets.AdminStylesheet">
</head>
<body class="min-h-full bg-page font-sans text-ink antialiased">
<header class="bg-night text-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3">
        <a href="@AdminPages.Root" class="flex min-w-0 items-center gap-2 font-heading text-lg font-bold text-white no-underline">
            <img src="/assets/brand/mark-cream.svg" alt="" width="28" height="28" class="size-7 shrink-0">
            <span class="truncate">Raven Hosting <span class="font-sans text-sm font-semibold text-white/70">admin</span></span>
        </a>
        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
            <img src="@PublicProfiles.ImageUrl(Admin.Identity)" alt="" width="32" height="32" referrerpolicy="no-referrer"
                 class="size-8 rounded-full border-2 border-white/70 bg-white/20 object-cover">
            <span class="hidden flex-col leading-tight md:flex">
                @if (Admin.Name != null)
                {
                    <span class="text-sm font-semibold">@Admin.Name</span>
                }
                <span class="@(Admin.Name != null ? "text-xs text-white/80" : "text-sm font-semibold")">@Admin.Identity</span>
            </span>
            <a href="/" class="rounded-[10px] border border-white/50 px-3 py-1 text-xs font-semibold text-white no-underline hover:bg-white/10">Site</a>
            <form method="post" action="@($"{UpgradePage.Root}/sign-out")">
                <input type="hidden" name="@Admin.Antiforgery.FormFieldName" value="@Admin.Antiforgery.RequestToken">
                <button type="submit" class="cursor-pointer rounded-[10px] border border-white/50 bg-transparent px-3 py-1 text-xs font-semibold text-white hover:bg-white/10">Sign out</button>
            </form>
        </div>
    </div>
    <nav aria-label="Admin sections" class="mx-auto max-w-7xl overflow-x-auto px-2">
        <ul class="flex gap-1 whitespace-nowrap">
            @foreach (var group in Groups)
            {
                <li>
                    <a href="@group.Href" aria-current="@(group.Key == Group.Key ? "page" : null)"
                       class="@(group.Key == Group.Key ? "border-white text-white" : "border-transparent text-white/75 hover:text-white") inline-block border-b-2 px-3 py-2 text-sm font-semibold no-underline">@group.Label</a>
                </li>
            }
        </ul>
    </nav>
</header>
@if (Group.Pages.Length > 0)
{
    <nav aria-label="@Group.Label" class="border-b border-line bg-white">
        <ul class="mx-auto flex max-w-7xl gap-1 overflow-x-auto px-2 whitespace-nowrap">
            @foreach (var (key, label, href) in Group.Pages)
            {
                <li>
                    <a href="@href" aria-current="@(key == Section ? "page" : null)"
                       class="@(key == Section ? "border-brand text-brand" : "border-transparent text-muted hover:text-ink") inline-block border-b-2 px-3 py-2 text-sm font-semibold no-underline">@label</a>
                </li>
            }
        </ul>
    </nav>
}
@if (!Admin.Checkout.Open)
{
    <a href="@($"{AdminPages.Root}/checkout")" class="block border-b border-amber-200 bg-amber-50 text-amber-900 no-underline hover:bg-amber-100">
        <span class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-2 px-4 py-1.5 text-xs">
            <span class="tag bg-amber-200 text-amber-900">BETA</span>
            <span>Checkout is closed to all but @Admin.Checkout.Testers.Count tester@(Admin.Checkout.Testers.Count == 1 ? "" : "s") until there is real payment.</span>
            <span class="font-semibold underline">Manage</span>
        </span>
    </a>
}

<main class="mx-auto max-w-7xl px-4 py-6 sm:py-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <h1 class="font-heading text-2xl font-bold text-ink sm:text-3xl">@Title</h1>
        @if (Actions != null)
        {
            <div class="flex flex-wrap gap-2">@Actions</div>
        }
    </div>

    @if (Admin.Done != null)
    {
        <p role="status" class="mb-6 rounded-lg border border-green/30 bg-green-tint px-4 py-3 text-sm font-semibold text-green">@Admin.Done</p>
    }
    @if (Admin.Error != null)
    {
        <p role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">@Admin.Error</p>
    }

    @ChildContent
</main>
<script>
    // Copy buttons (CopyButton): the text on the clipboard, and a tick for a moment; where the browser will not,
    // the text in a box to copy by hand
    document.addEventListener("click", async (event) => {
        const button = event.target.closest("[data-copy]");
        if (!button) return;
        try {
            await navigator.clipboard.writeText(button.dataset.copy);
            button.dataset.copied = "";
            setTimeout(() => delete button.dataset.copied, 1500);
        } catch {
            window.prompt("Copy this:", button.dataset.copy);
        }
    });
</script>
</body>
</html>

@code {
    [Parameter, EditorRequired] public AdminContext Admin { get; set; } = null!;
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>
    /// Which page is open: home; subscriptions, plans or checkout; codes, channels or renewals; reports
    /// </summary>
    [Parameter] public string Section { get; set; } = "home";

    /// <summary>Buttons beside the title</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private record NavGroup(string Key, string Label, string Href, (string Key, string Label, string Href)[] Pages, string[] Also);

    // The groups in the bar, and each one's pages in the row under it. Checkout is a beta switch, not a tab: the
    // strip under the bar goes to it while it is closed
    private static readonly NavGroup[] Groups =
    [
        new("home", "Overview", AdminPages.Root, [], []),
        new("subscriptions", "Subscriptions", $"{AdminPages.Root}/subscriptions",
            [("subscriptions", "Subscriptions", $"{AdminPages.Root}/subscriptions"), ("plans", "Plans", $"{AdminPages.Root}/plans")],
            ["checkout"]),
        new("marketing", "Marketing", $"{AdminPages.Root}/codes",
            [("codes", "Codes", $"{AdminPages.Root}/codes"), ("channels", "Channels", $"{AdminPages.Root}/codes/stats"),
             ("renewals", "Renewals", $"{AdminPages.Root}/renewals")],
            []),
        new("safety", "Safety", $"{AdminPages.Root}/reports", [("reports", "Abuse reports", $"{AdminPages.Root}/reports")], []),
    ];

    private NavGroup Group => Groups.FirstOrDefault(g => g.Key == Section || g.Pages.Any(p => p.Key == Section) || g.Also.Contains(Section))
                              ?? Groups[0];
}
