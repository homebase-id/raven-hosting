@* Step 2: the change, and how to pay *@
<SitePage Title="Confirm your new plan" Step="1">
    @if (Owned != null)
    {
        <p class="banner" role="note">
            This changes your @Owned.PlanName subscription to @Plan.Name, paid from today. What is left of its term is not refunded.
            @if (Owned.Holding.Count(m => m.Identity != Owned.Subscription.Owner) is > 0 and var others)
            {
                <text> The @(others == 1 ? "person" : $"{others} people") on it stay on it.</text>
            }
        </p>
    }
    <div class="card">
        <p class="muted">Change your plan from <strong>@CurrentPlanName</strong>@(Now?.QuotaBytes is { } quota ? $" ({StorageSize.Format(quota)})" : "") to</p>
        <h2>@Plan.Name</h2>
        <PlanDetails Plan="Plan" ShowPrices="false" />
        @if (PlanFit.Of(Plan, Now) is { Note: { } note } fit)
        {
            <p class="@(fit.IsMore ? "fit more" : "fit")">@note</p>
        }
    </div>

    <form method="get" action="@($"{UpgradePage.Root}/checkout")" class="card terms">
        <input type="hidden" name="plan" value="@Plan.Id">
        @if (Plan.IsGroup)
        {
            <p class="hint">You take one of its @Plan.Seats seats. After paying, you name the people on it; each joins with a link. You choose how much of its @Plan.Storage each gets.</p>
        }
        <fieldset>
            <legend>How would you like to pay?</legend>
            @for (var i = 0; i < Plan.Prices.Count; i++)
            {
                var price = Plan.Prices[i];
                <label><input type="radio" name="months" value="@price.Months" checked="@(i == 0)"> <PriceLabel Plan="Plan" Price="price" /></label>
            }
        </fieldset>
        <div class="actions">
            @if (CanBuy)
            {
                <button type="submit">Continue to checkout</button>
            }
            else
            {
                <button type="submit" disabled>Coming soon</button>
            }
            <a class="button secondary" href="@UpgradePage.Root">Back</a>
        </div>
        @if (!CanBuy)
        {
            <p class="muted">Buying a plan here opens soon. Until then your plan stays as it is.</p>
        }
    </form>
</SitePage>

@code {
    [Parameter] public Plan Plan { get; set; } = null!;
    [Parameter] public string CurrentPlanName { get; set; } = "";

    /// <summary>What the owner has now, as their host says</summary>
    [Parameter] public IdentityOnHost? Now { get; set; }

    /// <summary>Whether they may buy: purchases are open, or they are a tester</summary>
    [Parameter] public bool CanBuy { get; set; }

    /// <summary>The subscription they pay for now, which buying changes; null when they have none</summary>
    [Parameter] public SubscriptionView? Owned { get; set; }
}
